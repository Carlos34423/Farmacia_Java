<jasperReport name="rel03_estoque_abaixo_minimo" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28" uuid="9f43e151-efa9-4599-8830-4f072fa11291">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<style name="Zebra" mode="Opaque" fontName="DejaVu Sans">
		<conditionalStyle mode="Opaque" backcolor="#EEF4F7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<query language="sql"><![CDATA[SELECT COALESCE(f.nomeFantasia,'(sem fornecedor)') AS fornecedor,
       m.nome AS medicamento,
       c.nome AS categoria,
       m.quantidadeEstoque AS estoque,
       m.estoqueMinimo AS minimo,
       CAST(m.estoqueMinimo - m.quantidadeEstoque AS SIGNED) AS faltante
FROM medicamento m
LEFT JOIN fornecedor f ON f.codigoFornecedor=m.codigoFornecedor
LEFT JOIN CategoriaMedicamento c ON c.codigoCategoriaMedicamento=m.codigoCategoriaMedicamento
WHERE m.quantidadeEstoque < m.estoqueMinimo
ORDER BY fornecedor, faltante DESC]]></query>
	<field name="fornecedor" class="java.lang.String"/>
	<field name="medicamento" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="estoque" class="java.lang.Integer"/>
	<field name="minimo" class="java.lang.Integer"/>
	<field name="faltante" class="java.lang.Long"/>
	<variable name="TOT_REPOR" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{faltante}]]></expression>
	</variable>
	<variable name="TOT_ITENS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
	</variable>
	<group name="Fornecedor">
		<expression><![CDATA[$F{fornecedor}]]></expression>
