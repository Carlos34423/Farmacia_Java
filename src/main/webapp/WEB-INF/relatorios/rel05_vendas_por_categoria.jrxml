<jasperReport name="rel05_vendas_por_categoria" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28" uuid="b420d36f-d146-4d6d-9f4d-dbe180f9cfbc">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<style name="Zebra" mode="Opaque" fontName="DejaVu Sans">
		<conditionalStyle mode="Opaque" backcolor="#EEF4F7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="DATA_INICIAL" class="java.util.Date"/>
	<parameter name="DATA_FINAL" class="java.util.Date"/>
	<query language="sql"><![CDATA[SELECT c.nome AS categoria,
       CAST(SUM(i.quantidade) AS SIGNED) AS unidades,
       CAST(SUM(i.quantidade*i.precoUnitario) AS DECIMAL(12,2)) AS receita,
       CAST(ROUND(100*SUM(i.quantidade*i.precoUnitario)/SUM(SUM(i.quantidade*i.precoUnitario)) OVER (),1) AS DECIMAL(5,1)) AS participacao
FROM itemVenda i
JOIN venda v ON v.codigoVenda=i.codigoVenda
JOIN medicamento m ON m.codigoMedicamento=i.codigoMedicamento
JOIN CategoriaMedicamento c ON c.codigoCategoriaMedicamento=m.codigoCategoriaMedicamento
WHERE v.dataVenda BETWEEN $P{DATA_INICIAL} AND $P{DATA_FINAL}
GROUP BY c.codigoCategoriaMedicamento, c.nome
ORDER BY receita DESC]]></query>
	<field name="categoria" class="java.lang.String"/>
	<field name="unidades" class="java.lang.Long"/>
	<field name="receita" class="java.math.BigDecimal"/>
	<field name="participacao" class="java.math.BigDecimal"/>
	<variable name="TOT_UN" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{unidades}]]></expression>
	</variable>
	<variable name="TOT_REC" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{receita}]]></expression>
	</variable>
	<title height="270">
		<element kind="rectangle" uuid="32590e42-c64f-4c6f-b374-9b0294d781ba" mode="Opaque" x="0" y="0" width="555" height="62" backcolor="#1F6F8B">
			<pen lineWidth="0.0"/>
		</element>
		<element kind="staticText" uuid="8c722ab6-5ee8-416b-b2b9-8b7c4b0f83b1" x="10" y="6" width="535" height="30" forecolor="#FFFFFF" fontName="DejaVu Sans" fontSize="18.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Vendas por Categoria de Medicamento]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="textField" uuid="9f457b86-520b-4dfb-9e54-c58dfa48a229" x="10" y="36" width="535" height="22" forecolor="#FFFFFF" fontName="DejaVu Sans" fontSize="9.0" blankWhenNull="true" bold="false" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA["Período: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_INICIAL}) + " a " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{DATA_FINAL})]]></expression>
			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="chart" chartType="pie" uuid="83d50e8d-2667-45d3-a900-c50e7df90de4" x="0" y="72" width="555" height="190" showLegend="true" evaluationTime="Report">
			<titleExpression><![CDATA["Participação de cada categoria na receita"]]></titleExpression>
			<dataset kind="pie">
				<series>
					<keyExpression><![CDATA[$F{categoria}]]></keyExpression>
					<valueExpression><![CDATA[$F{receita}]]></valueExpression>
				</series>
			</dataset>
			<plot>
				<itemLabel/>
			</plot>
		</element>
	</title>
	<columnHeader height="24">
		<element kind="staticText" uuid="62fe10cf-8ea2-4cfd-b1f2-063a6151a1c5" mode="Opaque" x="0" y="0" width="215" height="24" forecolor="#FFFFFF" backcolor="#1F6F8B" fontName="DejaVu Sans" fontSize="9.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Categoria]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="staticText" uuid="f713e206-b69d-4128-9aa9-420041b4ec03" mode="Opaque" x="215" y="0" width="100" height="24" forecolor="#FFFFFF" backcolor="#1F6F8B" fontName="DejaVu Sans" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Unidades]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
