			</element>
			<element kind="textField" uuid="6e41588c-f9fe-4a3d-a233-3d4fc29c51bb" x="315" y="0" width="140" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="'R$ '#,##0.00" blankWhenNull="true" bold="false" hTextAlign="Right" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{receita}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="ec38c1ea-b604-4f0e-b0ca-2d25e6aca5ab" x="455" y="0" width="100" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="0.0'%'" blankWhenNull="true" bold="false" hTextAlign="Right" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{participacao}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
		</band>
	</detail>
