		</element>
		<element kind="staticText" uuid="cb6a1712-bfc7-49f6-b183-88e8218b3b4d" mode="Opaque" x="315" y="0" width="55" height="24" forecolor="#FFFFFF" backcolor="#1F6F8B" fontName="DejaVu Sans" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Estoque]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="staticText" uuid="fb05e3e2-e959-40fa-b3fa-58d0deee092f" mode="Opaque" x="370" y="0" width="100" height="24" forecolor="#FFFFFF" backcolor="#1F6F8B" fontName="DejaVu Sans" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Custo em risco]]></text>
