		</element>
		<element kind="staticText" uuid="71337c64-05cb-440b-ba89-004673860de7" mode="Opaque" x="470" y="0" width="85" height="24" forecolor="#FFFFFF" backcolor="#1F6F8B" fontName="DejaVu Sans" fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[Situação]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
	</columnHeader>
	<detail>
		<band height="20">
			<element kind="textField" uuid="29fc4eef-509c-4ecf-92f2-9503799cf548" x="0" y="0" width="195" height="20" fontName="DejaVu Sans" fontSize="9.0" blankWhenNull="true" bold="false" hTextAlign="Left" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{medicamento}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="8c8ee3ba-8d02-4572-bfdb-250861a890d9" x="195" y="0" width="75" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="dd/MM/yyyy" blankWhenNull="true" bold="false" hTextAlign="Center" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{validade}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="47794e78-1c14-43cb-8632-fa33d6f388f8" x="270" y="0" width="45" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="#,##0" blankWhenNull="true" bold="false" hTextAlign="Right" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{diasParaVencer}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="d8dafb55-eddd-4090-b9f2-b31374d14af3" x="315" y="0" width="55" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="#,##0" blankWhenNull="true" bold="false" hTextAlign="Right" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{estoque}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="d1d34641-ac11-4672-a1b1-dfaa7e9782fc" x="370" y="0" width="100" height="20" fontName="DejaVu Sans" fontSize="9.0" pattern="'R$ '#,##0.00" blankWhenNull="true" bold="false" hTextAlign="Right" vTextAlign="Middle" style="Zebra">
				<expression><![CDATA[$F{valorEmRisco}]]></expression>
				<box leftPadding="4" rightPadding="4" style="Zebra"/>
			</element>
			<element kind="textField" uuid="2e54b520-bc1d-426c-96b9-8c44a338be39" x="470" y="0" width="85" height="20" fontName="DejaVu Sans" fontSize="9.0" blankWhenNull="true" bold="false" hTextAlign="Center" vTextAlign="Middle" style="Situacao">
				<expression><![CDATA[$F{diasParaVencer} < 0 ? "VENCIDO" : ($F{diasParaVencer} <= 30 ? "CRÍTICO" : "ATENÇÃO")]]></expression>
				<box leftPadding="4" rightPadding="4" style="Situacao"/>
			</element>
		</band>
	</detail>
