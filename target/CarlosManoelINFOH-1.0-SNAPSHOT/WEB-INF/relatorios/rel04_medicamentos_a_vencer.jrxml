<jasperReport name="rel04_medicamentos_a_vencer" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28" uuid="d1b272e0-c58f-4e43-a60b-5796dfd650af">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<style name="Zebra" mode="Opaque" fontName="DejaVu Sans">
		<conditionalStyle mode="Opaque" backcolor="#EEF4F7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<style name="Situacao" mode="Opaque" forecolor="#FFFFFF" fontName="DejaVu Sans" bold="true">
		<conditionalStyle mode="Opaque" backcolor="#B00020">
			<conditionExpression><![CDATA[$F{diasParaVencer} < 0]]></conditionExpression>
		</conditionalStyle>
		<conditionalStyle mode="Opaque" backcolor="#E65100">
			<conditionExpression><![CDATA[$F{diasParaVencer} >= 0 && $F{diasParaVencer} <= 30]]></conditionExpression>
		</conditionalStyle>
		<conditionalStyle mode="Opaque" forecolor="#000000" backcolor="#F9A825">
			<conditionExpression><![CDATA[$F{diasParaVencer} > 30]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="DIAS" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[90]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT m.nome AS medicamento,
       m.dataValidade AS validade,
       CAST(DATEDIFF(m.dataValidade, CURDATE()) AS SIGNED) AS diasParaVencer,
       m.quantidadeEstoque AS estoque,
       CAST(m.quantidadeEstoque*COALESCE(m.precoCusto,0) AS DECIMAL(12,2)) AS valorEmRisco
FROM medicamento m
WHERE m.dataValidade IS NOT NULL
  AND m.dataValidade <= DATE_ADD(CURDATE(), INTERVAL $P{DIAS} DAY)
ORDER BY m.dataValidade]]></query>
	<field name="medicamento" class="java.lang.String"/>
	<field name="validade" class="java.sql.Date"/>
	<field name="diasParaVencer" class="java.lang.Long"/>
	<field name="estoque" class="java.lang.Integer"/>
	<field name="valorEmRisco" class="java.math.BigDecimal"/>
	<variable name="TOT_RISCO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{valorEmRisco}]]></expression>
	</variable>
	<variable name="QTD_VENCIDOS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{diasParaVencer} < 0 ? 1 : 0]]></expression>
	</variable>
	<variable name="QTD_ITENS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
	</variable>
	<title height="70">
		<element kind="rectangle" uuid="2c670900-0f12-445f-b105-e069b5339d0f" mode="Opaque" x="0" y="0" width="555" height="62" backcolor="#1F6F8B">
			<pen lineWidth="0.0"/>
		</element>
		<element kind="staticText" uuid="b4c23217-21e9-44a7-a6f3-ad60247122fc" x="10" y="6" width="535" height="30" forecolor="#FFFFFF" fontName="DejaVu Sans" fontSize="18.0" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Medicamentos a Vencer]]></text>
			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="textField" uuid="84b95e23-563b-4fa2-8554-d7ec41f55dfa" x="10" y="36" width="535" height="22" forecolor="#FFFFFF" fontName="DejaVu Sans" fontSize="9.0" blankWhenNull="true" bold="false" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA["Validade até hoje + " + $P{DIAS} + " dias  |  vermelho = vencido, laranja = até 30 dias, amarelo = acima de 30 dias"]]></expression>
			<box leftPadding="4" rightPadding="4"/>
		</element>
	</title>
