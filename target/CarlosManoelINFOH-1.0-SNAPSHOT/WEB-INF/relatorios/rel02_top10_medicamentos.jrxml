<jasperReport name="rel02_top10_medicamentos" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28" uuid="b4756e08-a09c-4096-8ed3-58c62ad25c75">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<style name="Zebra" mode="Opaque" fontName="DejaVu Sans">
		<conditionalStyle mode="Opaque" backcolor="#EEF4F7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="DATA_INICIAL" class="java.util.Date"/>
	<parameter name="DATA_FINAL" class="java.util.Date"/>
	<query language="sql"><![CDATA[SELECT m.nome AS medicamento,
       CAST(SUM(i.quantidade) AS SIGNED) AS unidades,
       CAST(SUM(i.quantidade*i.precoUnitario) AS DECIMAL(12,2)) AS receita
FROM itemVenda i
JOIN venda v ON v.codigoVenda=i.codigoVenda
JOIN medicamento m ON m.codigoMedicamento=i.codigoMedicamento
WHERE v.dataVenda BETWEEN $P{DATA_INICIAL} AND $P{DATA_FINAL}
GROUP BY m.codigoMedicamento, m.nome
ORDER BY unidades DESC, receita DESC
LIMIT 10]]></query>
	<field name="medicamento" class="java.lang.String"/>
	<field name="unidades" class="java.lang.Long"/>
	<field name="receita" class="java.math.BigDecimal"/>
	<variable name="TOT_UN" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{unidades}]]></expression>
	</variable>
	<variable name="TOT_REC" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{receita}]]></expression>
	</variable>
