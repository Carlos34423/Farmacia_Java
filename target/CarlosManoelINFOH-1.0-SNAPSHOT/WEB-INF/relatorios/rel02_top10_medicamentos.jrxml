			<box leftPadding="4" rightPadding="4"/>
		</element>
		<element kind="chart" chartType="bar" uuid="1ee28618-57d6-4386-a226-e563ba441fd1" x="0" y="72" width="555" height="190" showLegend="false" evaluationTime="Report">
