		<element kind="textField" uuid="2439b14a-6604-4b69-9ecb-9e5730df948d" x="405" y="4" width="150" height="22" forecolor="#000000" fontName="DejaVu Sans" fontSize="9.0" pattern="'R$ '#,##0.00" blankWhenNull="true" bold="true" hTextAlign="Right" vTextAlign="Middle">
