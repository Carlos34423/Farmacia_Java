<jasperReport name="rel01_vendas_por_mes" language="java" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28" uuid="558b54bc-ca1f-4e44-b044-609d45a450e3">
	<property name="net.sf.jasperreports.export.xls.detect.cell.type" value="true"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
	<style name="Zebra" mode="Opaque" fontName="DejaVu Sans">
		<conditionalStyle mode="Opaque" backcolor="#EEF4F7">
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="DATA_INICIAL" class="java.util.Date"/>
	<parameter name="DATA_FINAL" class="java.util.Date"/>
	<query language="sql"><![CDATA[SELECT DATE_FORMAT(v.dataVenda,'%Y-%m') AS mes,
       CAST(COUNT(*) AS SIGNED) AS qtdVendas,
       CAST(SUM(v.valorTotal) AS DECIMAL(12,2)) AS faturamento,
       CAST(AVG(v.valorTotal) AS DECIMAL(12,2)) AS ticketMedio
FROM venda v
WHERE v.dataVenda BETWEEN $P{DATA_INICIAL} AND $P{DATA_FINAL}
GROUP BY DATE_FORMAT(v.dataVenda,'%Y-%m')
ORDER BY mes]]></query>
	<field name="mes" class="java.lang.String"/>
	<field name="qtdVendas" class="java.lang.Long"/>
	<field name="faturamento" class="java.math.BigDecimal"/>
	<field name="ticketMedio" class="java.math.BigDecimal"/>
	<variable name="TOT_VENDAS" calculation="Sum" class="java.lang.Long">
		<expression><![CDATA[$F{qtdVendas}]]></expression>
	</variable>
	<variable name="TOT_FAT" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{faturamento}]]></expression>
	</variable>
	<title height="270">
